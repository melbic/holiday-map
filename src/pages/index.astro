<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Holiday Map</title>
    <meta
      name="description"
      content="A private holiday planning map loaded from a local CSV file in your browser."
    />
  </head>
  <body>
    <main class="shell">
      <aside class="list-panel" aria-label="Locations">
        <header class="list-header">
          <div>
            <p class="eyebrow">Holiday planner</p>
            <h1>Holiday Map</h1>
          </div>
          <span class="pin-count" id="pin-count">0 pins</span>
        </header>

        <section class="upload-panel" aria-label="Private data controls">
          <div class="upload-actions">
            <label class="primary-button" for="csv-upload">Upload CSV</label>
            <input id="csv-upload" class="hidden-input" type="file" accept=".csv,text/csv" />
            <button class="secondary-button" type="button" id="clear-csv">Clear local data</button>
          </div>
          <p class="helper-text" id="storage-status">
            Your CSV stays in this browser and is restored from local storage on reload.
          </p>
        </section>

        <div class="warning-box" id="warning-box" aria-live="polite" hidden>
          <strong>Skipped rows</strong>
          <ul id="warning-list"></ul>
        </div>

        <p class="empty-state" id="list-empty-state">
          Upload a CSV to keep your private holiday data local to this browser.
        </p>

        <ul class="location-list" id="mapped-list" aria-label="Mapped locations" hidden></ul>

        <section class="review-panel" id="review-panel" aria-label="Needs review" hidden>
          <div class="section-header">
            <h2>Needs review</h2>
            <span class="review-count" id="review-count">0</span>
          </div>
          <ul class="location-list review-list" id="review-list"></ul>
        </section>
      </aside>

      <section class="map-panel">
        <div id="map" class="map" aria-label="Holiday map"></div>
      </section>
    </main>
    <script>
      import "../scripts/holiday-map";
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f3f6fb;
    --panel: rgba(255, 255, 255, 0.82);
    --panel-border: rgba(20, 35, 62, 0.08);
    --text: #152033;
    --muted: #64748b;
    --accent: #0f766e;
    --accent-strong: #0b5d57;
    --accent-soft: rgba(15, 118, 110, 0.12);
    --shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: "Instrument Sans", "Avenir Next", "Segoe UI", sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at top left, rgba(16, 185, 129, 0.12), transparent 28%),
      radial-gradient(circle at bottom right, rgba(56, 189, 248, 0.12), transparent 24%),
      linear-gradient(180deg, #eef4fb, #f8fafc);
  }

  h1,
  p {
    margin-top: 0;
  }

  .shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(320px, 400px) minmax(0, 1fr);
  }

  .list-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-right: 1px solid var(--panel-border);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(247, 250, 252, 0.84)),
      rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(18px);
  }

  .list-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.25rem;
  }

  .pin-count {
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 2vw, 2.35rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
  }

  .warning-box {
    padding: 0.9rem 1rem;
    border-radius: 18px;
    background: rgba(255, 248, 231, 0.95);
    border: 1px solid rgba(217, 119, 6, 0.18);
    color: #92400e;
    font-size: 0.92rem;
  }

  .upload-panel {
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
  }

  .upload-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(15, 118, 110, 0.14);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .primary-button {
    background: var(--accent);
    color: white;
    box-shadow: 0 10px 20px rgba(15, 118, 110, 0.18);
  }

  .secondary-button {
    background: rgba(255, 255, 255, 0.92);
    color: var(--text);
  }

  .primary-button:hover,
  .primary-button:focus-visible,
  .secondary-button:hover,
  .secondary-button:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(15, 118, 110, 0.32);
    outline: none;
  }

  .hidden-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .helper-text {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .helper-text.is-error {
    color: #b91c1c;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .review-count {
    min-width: 2rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.16);
    color: #475569;
    font-size: 0.78rem;
    font-weight: 700;
    text-align: center;
  }

  .warning-box ul {
    margin: 0.5rem 0 0;
    padding-left: 1.15rem;
  }

  .location-list {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: auto;
    padding-right: 0.15rem;
  }

  .location-button {
    width: 100%;
    padding: 1rem 1rem 1.05rem;
    text-align: left;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    cursor: pointer;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .review-card {
    display: grid;
    gap: 0.65rem;
    padding: 1rem 1rem 1.05rem;
    border: 1px dashed rgba(148, 163, 184, 0.32);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.76);
  }

  .location-button:hover,
  .location-button:focus-visible,
  .location-button.is-active {
    transform: translateY(-1px);
    border-color: rgba(15, 118, 110, 0.28);
    background: rgba(240, 253, 250, 0.96);
    box-shadow: 0 14px 30px rgba(15, 118, 110, 0.1);
    outline: none;
  }

  .location-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
  }

  .location-title,
  .location-type,
  .location-description {
    display: block;
  }

  .location-title {
    font-weight: 700;
    color: var(--text);
  }

  .location-type {
    flex-shrink: 0;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(226, 232, 240, 0.9);
    color: #475569;
    text-transform: capitalize;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .location-description,
  .empty-state {
    color: var(--muted);
  }

  .review-panel {
    display: grid;
    gap: 0.8rem;
  }

  .review-list {
    overflow: visible;
  }

  .review-badge {
    width: fit-content;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: rgba(217, 119, 6, 0.12);
    color: #92400e;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .review-link {
    width: fit-content;
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .review-link:hover,
  .review-link:focus-visible {
    text-decoration: underline;
    outline: none;
  }

  .location-description {
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .map-panel {
    position: relative;
    min-height: 100vh;
    padding: 0;
  }

  .map {
    height: 100%;
    min-height: 100vh;
    width: 100%;
  }

  .map :global(.leaflet-control-zoom),
  .map :global(.leaflet-control-attribution) {
    background: var(--panel);
    backdrop-filter: blur(18px);
    border: 1px solid var(--panel-border);
    box-shadow: var(--shadow);
  }

  .map :global(.leaflet-control-zoom) {
    border-radius: 18px;
    overflow: hidden;
  }

  .map :global(.leaflet-control-attribution) {
    border-radius: 14px 0 0;
    padding: 0.2rem 0.45rem;
  }

  .map :global(.emoji-pin-wrapper) {
    position: relative;
    width: 48px;
    height: 62px;
    background: transparent;
    border: 0;
  }

  .map :global(.emoji-pin-shadow) {
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 20px;
    height: 8px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.18);
    transform: translateX(-50%);
    filter: blur(3px);
  }

  .map :global(.emoji-pin) {
    position: absolute;
    inset: 0 auto auto 50%;
    width: 48px;
    height: 48px;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
  }

  .map :global(.emoji-pin)::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 18px 18px 18px 4px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(237, 255, 251, 0.98));
    border: 1px solid rgba(15, 118, 110, 0.18);
    box-shadow:
      0 16px 30px rgba(15, 23, 42, 0.12),
      0 3px 10px rgba(15, 118, 110, 0.12);
    transform: rotate(-45deg);
    transform-origin: center;
    z-index: 0;
  }

  .map :global(.emoji-pin-glyph) {
    font-size: 1.15rem;
    line-height: 1;
    position: relative;
    z-index: 1;
    transform: rotate(45deg) translateY(-1px);
  }

  .map :global(.leaflet-marker-icon:hover .emoji-pin),
  .map :global(.leaflet-marker-icon:focus .emoji-pin) {
    transform: translateX(-50%) translateY(-2px);
  }

  .map-empty {
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .shell {
      grid-template-columns: 1fr;
    }

    .list-panel {
      min-height: 42vh;
      max-height: 42vh;
      border-right: 0;
      border-bottom: 1px solid var(--panel-border);
    }

    .map-panel,
    .map {
      min-height: 58vh;
      height: 58vh;
    }

    .location-list {
      padding-bottom: 0.25rem;
    }
  }
</style>
